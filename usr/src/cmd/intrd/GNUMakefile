# GNUMakefile - build intrd-test on macOS (or any GNU make host)
# Usage: make          -- build intrd-test
#        make test     -- build and run all test cases
#        make clean    -- remove build artifacts

CXX	= c++
CXXFLAGS = -std=c++17 -Wall -Wextra -Wno-sign-compare -Wno-unused-parameter

TARGET	= intrd-test
OBJS	= intrd-main.o intrd-test.o

all: $(TARGET)

test: $(TARGET)
	@cd test && sh run-test2.sh

$(TARGET): $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $(OBJS)

%.o: %.cc intrd_sys.h
	$(CXX) $(CXXFLAGS) -c -o $@ $<

clean:
	rm -f $(OBJS) $(TARGET)
