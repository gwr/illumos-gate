# One object-member mutex protects two member data objects.
declare mutex-protects-data command_mutex_object.lock command_mutex_object.value command_mutex_object.second

# A global mutex protects global data.
declare mutex-protects-data command_mutex_global_lock command_mutex_global_value
declare mutex-protects-data command_mutex_global_lock command_mutex_global_value

# Source/command and command/command duplicates remain visible declarations.
declare mutex-protects-data command_mutex_object.lock command_mutex_object.source_value
declare mutex-protects-data command_mutex_object.lock command_mutex_object.source_value
