# Normalized Old Solaris Lock Lint protection report.
analyzer	original_datum	datum	write_state	common_state	common_locks	observed_locks	protection	notes
osll	sample.c:common	sample.c::common	unknown	locks	sample.c::common_lock	sample.c::common_lock		
osll	sample.c:mixed	sample.c::mixed	yes	empty				
osll	sample.c:one	sample.c::one	unknown	locks	sample.c::common_lock	sample.c::common_lock		
osll	sample.c:read_only	sample.c::read_only	no	empty				
osll	sample.c:rw	sample.c::rw	unknown	locks	sample.c::common_rwlock	sample.c::common_rwlock		
osll	sample.c:two	sample.c::two	yes	empty				
osll	sample.c:unlocked	sample.c::unlocked	yes	empty				
osll	sample_state::field	sample_state::field	unknown	locks	sample_state::lock	sample_state::lock		
